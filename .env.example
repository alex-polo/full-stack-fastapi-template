TAG=0.0.1a

# Environment: local, staging, development, production
ENVIRONMENT=production
# Domain
# This would be set to the production domain with an env var on deployment
DOMAIN=localhost
# Used by the backend to generate links in emails to the frontend
#FRONTEND_HOST=http://localhost:5173

# Compose environment variables
COMPOSE_PROJECT_NAME=full-stack-template
#COMPOSE_PROJECT_NAME=full-stack-template
#COMPOSE_PROJECT_NAME=full-stack-template-${TAG}
#COMPOSE_FILE=compose.yml:compose.override.yml
COMPOSE_FILE=compose.yml


# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=client
# Project
PROJECT_NAME="Full Stack FastAPI Project"
PROJECT_DESCRIPTION="A full stack FastAPI project template with Docker, Postgres, and more."

# Client
CLIENT_PORT=8080

# Backend
BACKEND_PORT=8005
BACKEND_HOST=backend
BACKEND_API_PREFIX=/api

# BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
# SECRET_KEY=changethis
# ROOT_USER=admin@example.com
# ROOT_USER_PASSWORD=changethis

# Postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=apps
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Emails
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=info@example.com
# SMTP_TLS=True
# SMTP_SSL=False
# SMTP_PORT=587
MAILDEV_WEB_PORT=1080
MAILDEV_SMTP_PORT=1025

# Pg admin
PGADMIN_PORT=9455
PGADMIN_DEFAULT_EMAIL=admin@template.com
PGADMIN_DEFAULT_PASSWORD=changethis

SENTRY_DSN="
SENTRY_LOG_LEVEL=ERROR

# Root user
ROOT_USER_EMAIL=root@local.ru
ROOT_USER_PASSWORD=abc123
ROOT_USER_IS_CREATE=true

# --- Auth settings ---
AUTH_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1
AUTH_JWT_REFRESH_TOKEN_EXPIRE_DAYS=1
AUTH_JWT_PRIVATE_KEY_PATH=./certificates/jwt-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=./certificates/jwt-public.pem
AUTH_COOKIE_SECURE=false


# ===========================================
# ОПЦИОНАЛЬНЫЕ (раскомментировать при необходимости)
# ===========================================
# Примечание: Для использования опциональных переменных добавьте их
# в секцию environment файла compose.yml или compose.override.yml

# Logging
# BACKEND__LOGGING__LOG_LEVEL=DEBUG
# BACKEND__LOGGING__SENTRY_DSN=
# BACKEND__LOGGING__SENTRY_TRACES_SAMPLE_RATE=1.0
# BACKEND__LOGGING__SENTRY_LOG_LEVEL=ERROR

# Database (pool settings)
# BACKEND__DATABASE__ECHO=false
# BACKEND__DATABASE__ECHO_POOL=false
# BACKEND__DATABASE__POOL_SIZE=50
# BACKEND__DATABASE__MAX_OVERFLOW=10
# BACKEND__DATABASE__POOL_PRE_PING=true
# BACKEND__DATABASE__POOL_RECYCLE=3600
# BACKEND__DATABASE__AUTOFLUSH=false
# BACKEND__DATABASE__AUTOCOMMIT=false
# BACKEND__DATABASE__EXPIRE_ON_COMMIT=false

# API Prefix
# BACKEND__API_PREFIX__PREFIX=/api
# BACKEND__API_PREFIX__V1__PREFIX=/v1

# Gunicorn
# BACKEND__GUNICORN__WORKERS=1
# BACKEND__GUNICORN__TIMEOUT=60
# BACKEND__GUNICORN__WORKER_CLASS=uvicorn.workers.UvicornWorker
# BACKEND__GUNICORN__ACCESS_LOG=-
# BACKEND__GUNICORN__ERROR_LOG=-
# BACKEND__GUNICORN__LOG_LEVEL=INFO
